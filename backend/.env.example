# Copy this file to .env and fill in your own values.
# Never commit the real .env file or real credentials.

# MySQL connection
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Escalation engine
# Minutes a request can stay "Pending" or "In Progress" before it is
# auto-escalated. Kept small by default so it's easy to demo.
ESCALATION_THRESHOLD_MINUTES=30
ESCALATION_CHECK_INTERVAL_SECONDS=60
